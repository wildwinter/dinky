{
    "name": "dinky",
    "productName": "Dinky",
    "version": "0.2.8",
    "dinkVersion": "0.1.2",
    "inkjsVersion": "2.3.2",
    "main": "dist-electron/main.js",
    "scripts": {
        "dev": "vite",
        "start": "npm run dev",
        "prebuild": "node scripts/update-simple-vc-lib.mjs && node scripts/sync-dink-builds.mjs",
        "build": "node scripts/check-node.mjs && vite build",
        "clean": "shx rm -rf dist dist-electron release",
        "preview": "npm run build && electron .",
        "dist-mac": "npm run clean && npm run build && electron-builder --mac",
        "dist-win": "npm run clean && npm run build && electron-builder --win --x64",
        "dist": "npm run clean && npm run build && electron-builder --mac && electron-builder --win --x64",
        "publish-mac": "npm run clean && npm run build && dotenv -e .env.local -- electron-builder --mac --publish always",
        "publish-win": "npm run clean && npm run build && dotenv -e .env.local -- electron-builder --win --x64 --publish always",
        "publish": "npm run clean && npm run build && dotenv -e .env.local -- electron-builder --mac --publish always && dotenv -e .env.local -- electron-builder --win --x64 --publish always",
        "release:patch": "npm version patch && git push --follow-tags && npm run publish",
        "release:minor": "npm version minor && git push --follow-tags && npm run publish",
        "release:major": "npm version major && git push --follow-tags && npm run publish",
        "test": "npm run build && mocha"
    },
    "build": {
        "appId": "net.wildwinter.dinky",
        "productName": "Dinky",
        "publish": {
            "provider": "github",
            "owner": "wildwinter",
            "repo": "dinky"
        },
        "mac": {
            "category": "public.app-category.productivity",
            "icon": "build/DinkyApp.icns",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "notarize": true,
            "target": [
                "dmg",
                "zip"
            ],
            "extraResources": [
                {
                    "from": "resources/compiler/DinkCompiler",
                    "to": "compiler/DinkCompiler"
                },
                {
                    "from": "resources/compiler/DinkViewer",
                    "to": "compiler/DinkViewer"
                }
            ]
        },
        "files": [
            "dist-electron/**/*",
            "dist/**/*",
            "build/**/*"
        ],
        "directories": {
            "output": "release"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "perMachine": true,
            "include": "build/installer.nsh",
            "shortcutName": "Dinky",
            "uninstallDisplayName": "Dinky"
        },
        "win": {
            "target": "nsis",
            "icon": "build/DinkyApp.ico",
            "extraResources": [
                {
                    "from": "resources/compiler/DinkCompiler.exe",
                    "to": "compiler/DinkCompiler.exe"
                },
                {
                    "from": "resources/compiler/DinkViewer.exe",
                    "to": "compiler/DinkViewer.exe"
                }
            ]
        },
        "extraResources": [
            {
                "from": "build/DinkyApp.ico",
                "to": "DinkyApp.ico"
            }
        ],
        "fileAssociations": [
            {
                "ext": "dinkproj",
                "name": "Dinky Project",
                "role": "Editor"
            },
            {
                "ext": "ink",
                "name": "Ink File",
                "role": "Editor"
            }
        ]
    },
    "keywords": [],
    "author": "Ian Thomas",
    "license": "MIT",
    "description": "Ink-script editor",
    "dependencies": {
        "@wildwinter/simple-vc-lib": "^0.2.0",
        "electron-updater": "^6.8.3",
        "inkjs": "^2.3.2",
        "jsonc-parser": "^3.3.1",
        "monaco-editor": "^0.50.0",
        "nspell": "^2.1.5"
    },
    "devDependencies": {
        "chai": "^6.2.2",
        "dotenv-cli": "^11.0.0",
        "electron": "^40.0.0",
        "electron-builder": "^26.4.0",
        "mocha": "^11.7.5",
        "shx": "^0.4.0",
        "vite": "^7.3.1",
        "vite-plugin-electron": "^0.28.0",
        "vite-plugin-electron-renderer": "^0.14.5"
    }
}
